{
  "name": "@adonis-agora/config-client",
  "version": "1.0.0",
  "description": "Remote-safe client for an @adonis-agora/config server — fetch a scope with a shared secret or authkit client credentials, from any runtime — and React/Inertia bindings for the keys an app lets the browser read. Part of the Agora ecosystem.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-config.git",
    "directory": "packages/client"
  },
  "homepage": "https://davidecarvalho.github.io/agora/docs/config",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/adonis-agora-config/issues"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "config",
    "config-client",
    "react",
    "inertia",
    "agora"
  ],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./react": {
      "types": "./dist/src/react/index.d.ts",
      "import": "./dist/src/react/index.js",
      "default": "./dist/src/react/index.js"
    },
    "./react/inertia": {
      "types": "./dist/src/react/inertia.d.ts",
      "import": "./dist/src/react/inertia.js",
      "default": "./dist/src/react/inertia.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@adonis-agora/config-core": "workspace:^"
  },
  "peerDependencies": {
    "@adonis-agora/authkit-client": "^1.0.0",
    "react": "^19.0.0",
    "@inertiajs/react": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@adonis-agora/authkit-client": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@inertiajs/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonis-agora/authkit-client": "1.0.0",
    "@inertiajs/react": "3.7.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
