// import env from '#start/env'
import { defineConfig } from '@adonis-agora/config'

/**
 * This app reads its configuration from the Agora config server.
 *
 * The values reach \`config/*.ts\` only through the bootstrap entry in \`bin/server.ts\`
 * (\`import { bootstrapConfig } from '@adonis-agora/config/bootstrap'\`), because config files load
 * before any provider boots. Without it, values arrive at boot for controllers and services.
 */
export default defineConfig({
  // url, token and partition come from @adonis-agora/authkit-client (\`service\` in
  // config/authkit_client.ts). To set them yourself (each field you set wins):
  // tenant: {
  //   url: env.get('CONFIG_URL'),
  //   partition: env.get('CONFIG_APP'),
  //   token: env.get('CONFIG_TOKEN'),
  //   // Boot with the last configuration received when the server is unreachable:
  //   snapshotPath: 'storage/config/snapshot.json',
  // },
  topology: 'tenant',
})
