{
  "name": "@adonis-agora/config-core",
  "version": "0.1.4",
  "description": "Document format, flattening, diffing and versioning for @adonis-agora/config.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavideCarvalho/adonis-agora-config.git",
    "directory": "packages/core"
  },
  "homepage": "https://davidecarvalho.github.io/agora/docs/config",
  "bugs": {
    "url": "https://github.com/DavideCarvalho/adonis-agora-config/issues"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "config",
    "spring-cloud-config",
    "agora"
  ],
  "author": "Davi Carvalho <davi@goflip.ai>",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "agora": {
    "versioning": "independent"
  }
}
